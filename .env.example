# AeroBaaS configuration (copy to .env). Values marked REQUIRED must be set.

# REQUIRED: at least 32 random characters. Generate: openssl rand -base64 48
AERO_JWT_SECRET=

# REQUIRED: PostgreSQL. The schema is created/updated automatically at startup.
AERO_DATABASE_URL=postgres://aero:CHANGE_ME@localhost:5432/aero
# Used by docker-compose.yml for the bundled PostgreSQL container
POSTGRES_PASSWORD=CHANGE_ME
AERO_DATABASE_MAX_CONNECTIONS=20

# Server
AERO_SERVER_HOST=0.0.0.0
AERO_SERVER_PORT=8080
# Public URL of the admin (used in invite links)
AERO_PUBLIC_URL=http://localhost:8080
# Browser origins allowed to call the API, comma separated. Empty = same origin only.
AERO_CORS_ORIGINS=
# true only behind your own reverse proxy (then X-Forwarded-For is trusted for client IPs)
AERO_TRUST_PROXY=false
AERO_INSPECTOR_RETENTION_DAYS=30

# Security
# Platform admins (comma separated emails). Empty = the first registered user.
AERO_PLATFORM_ADMINS=
# Failed logins per email before a 15-minute lock
AERO_LOGIN_MAX_FAILURES=10
# Optional: key for signed compliance records (32+ chars). Derived from AERO_JWT_SECRET when empty.
AERO_SIGNING_KEY=
AERO_HAZMAT_ENABLED=true
AERO_REMEDIATION_ENABLED=true

# Wasm runtime (stub until Phase 2)
AERO_WASM_MAX_MEMORY_MB=128
AERO_WASM_HAZMAT_EGRESS=true

# AI (stub until Phase 2; Phase 2 adds an OpenAI-compatible endpoint, e.g. Ollama)
AERO_AI_MODEL=Qwen-2.5-Coder-1.5B-Instruct
AERO_AI_QUANTIZATION=Q4

# CLI client commands (aero functions, aero create-key, aero scan)
# AERO_URL=http://localhost:8080
# AERO_TOKEN=aero_...
