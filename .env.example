# AeroBaaS Environment Configuration
# Copy to .env and adjust values

# Server
AERO_SERVER_HOST=0.0.0.0
AERO_SERVER_PORT=8080

# Database
AERO_DB_URL=surrealkv://data/aero.db
AERO_DB_NAMESPACE=aerobaas

# Wasm Runtime
AERO_WASM_MAX_MEMORY_MB=128
AERO_WASM_HAZMAT_EGRESS=true

# AI Engine
AERO_AI_MODEL=Qwen-2.5-Coder-1.5B-Instruct
AERO_AI_QUANTIZATION=Q4
AERO_AI_GPU=cpu

# Security
AERO_ENCRYPTION_KEY=change-me-in-production-32bytes
AERO_HAZMAT_ENABLED=true
AERO_REMEDIATION_ENABLED=true

# Erlang Orchestrator
AERO_ERLANG_NODE=aero_orchestrator@localhost
AERO_ERLANG_COOKIE=aero_default_cookie

# JWT
AERO_JWT_SECRET=change-me-in-production
